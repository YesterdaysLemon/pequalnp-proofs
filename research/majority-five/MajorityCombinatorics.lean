import FirstGateBasis

namespace FiveMajority
open Paired Paired.Split LiveRestriction

def coord (i : Fin 5) : Coord := (i.val,false)
def keys := List.ofFn coord
def vote (x : Fin 5 → Bool) : Bool := decide (3 ≤ (List.ofFn x).count true)
def fn (x : Row) : Bool := vote (fun i => x (coord i))
def onRow (r : Nat) : Fin 5 → Bool := fun i => r.testBit i.val
def expand (r : Nat) : Row := fun p => r.testBit p.1
def opCode (o : Op) := (o false false).toNat + 2*(o false true).toNat +
  4*(o true false).toNat + 8*(o true true).toNat
