def witness (i j : Fin 5) (o : Op) (one : Bool) :=
  ((witnesses[(i.val*5+j.val)*16+opCode o]?.getD 0) >>> (if one then 10 else 0)) % 1024
def collision (i j : Fin 5) (o : Op) (one : Bool) : Prop :=
  let w := witness i j o one
  let a := onRow (w/32)
  let b := onRow (w%32)
  vote a ≠ vote b ∧ o (a i) (a j) = o (b i) (b j) ∧
    ∀ v : Fin 5, v ≠ i → (one = true ∨ v ≠ j) → a v = b v

instance (i j : Fin 5) (o : Op) (one : Bool) : Decidable (collision i j o one) := by
  unfold collision; infer_instance

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem pair_collision : ∀ i j : Fin 5, i ≠ j → ∀ o : Op, collision i j o false := by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem one_collision : ∀ i j : Fin 5, i ≠ j → ∀ o : Op, o false false = false →
    FirstGate.parity o = false → ¬(∀ u v, o u v = u) → ¬(∀ u v, o u v = v) →
    collision i j o true := by decide +kernel

theorem canal : ∀ o : Op, o false false = false → FirstGate.parity o = false →
    ¬(∀ u v, o u v = v) → ∃ b, ∀ t, o b t = o b false := by decide +kernel

end FiveMajority
